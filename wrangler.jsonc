{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veroroute-edge",
  // "account_id": "<YOUR_ACCOUNT_ID>",  // Optional: only needed with multiple CF accounts
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI binding (free tier: 10,000 neurons/day)
  "ai": {
    "binding": "AI"
  },

  // KV Namespaces — B-3: real namespace IDs replaced with placeholders.
  // Run: wrangler kv:namespace create OMNI_CACHE
  //      wrangler kv:namespace create OMNI_KEYS
  // Then paste the returned IDs below.
  "kv_namespaces": [
    {
      "binding": "OMNI_CACHE",
      "id": "5af4ca41f0db439192fbce77ca0e2523"
    },
    {
      "binding": "OMNI_KEYS",
      "id": "193fa6ba2089467985ec2aced7053eb8"
    }
  ],

  // Non-secret runtime defaults. AUTH_TOKEN is the only first-run secret; provider credentials are added through Administration.
  "vars": {
    "DEFAULT_ROUTING_STRATEGY": "priority",
    "DEFAULT_OUTPUT_STYLE": "none",
    "ENABLE_MODALITY_BRIDGE": "true",
    "ENABLE_CONTEXT_COMPRESSION": "true",
    "ENABLE_JINA_READER": "true",
    "ENABLE_MCP_SERVER": "false",
    "ENABLE_QUOTA_SHARING": "false",
    "MAX_RETRIES": "3",
    "RETRY_DELAY_MS": "1000",
    "CASCADE_TIMEOUT_MS": "45000",
    "CACHE_TTL_SECONDS": "3600",
    "QUOTA_MAX_REQUESTS": "1000",
    "QUOTA_WINDOW_SECONDS": "60"
  },

  "observability": {
    "enabled": true
  }
}